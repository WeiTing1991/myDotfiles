// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "ui_font_features": { "calt": false, "liga": false },
  "buffer_font_features": { "calt": false, "liga": false },
  "terminal": {
    "font_size": 12.0,
  },
  "cli_default_open_behavior": "new_window",
  "audio": null,
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "edit_predictions": {
    "provider": "copilot",
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "effort": "medium",
        "model": "opus",
        "mode": "default",
      },
      "type": "registry",
    },
  },
  "project_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "agent": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.5",
      "enable_thinking": true,
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "right",
  },
  "git_hosting_providers": [
    {
      "provider": "github",
      "name": "WeiTing1991",
      "base_url": "https://github.com/",
    },
  ],
  "diff_view_style": "split",
  "ui_font_size": 16,
  "buffer_font_size": 12,
  "theme": {
    "mode": "dark",
    "light": "Suannhai Shironeri",
    "dark": "Suannhai Jiufen",
  },
  "show_whitespaces": "boundary",
  "horizontal_scroll_margin": 0,
  "autosave": "off",
  "relative_line_numbers": "enabled",

  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "always",
    "use_smartcase_find": true,
    "highlight_on_yank_duration": 100,
  },
}
