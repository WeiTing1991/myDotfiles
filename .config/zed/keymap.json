// Zed keymap — mirrors ~/.ideavimrc
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  // ── Window navigation (map <C-h/j/k/l> <C-w>h/j/k/l) ──────────
  {
    "context": "Editor && VimControl && !menu",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
    },
  },
  {
    "context": "Dock",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
    },
  },

  // ── Normal / visual / operator ───────────────────────────────
  {
    "context": "VimControl && !menu",
    "bindings": {
      // Keep the cursor centered (<C-d>zz, <C-u>zz, nzzzv, Nzzzv)
      "ctrl-d": ["workspace::SendKeystrokes", "ctrl-d z z"],
      "ctrl-u": ["workspace::SendKeystrokes", "ctrl-u z z"],
      "n": ["workspace::SendKeystrokes", "n z z z v"],
      "shift-n": ["workspace::SendKeystrokes", "shift-n z z z v"],

      "ctrl-c": "editor::Cancel",
      "shift-y": "vim::YankToEndOfLine",

      // Splits (<C-w>5 / <C-w>')
      "ctrl-w 5": "pane::SplitDown",
      "ctrl-w '": "pane::SplitRight",
      "ctrl-q":"pane::CloseActiveItem",

      // LSP / go-to
      "g d": "editor::GoToDefinition",
      "g i": "editor::GoToImplementation",
      "g y": "editor::GoToTypeDefinition",
      "g h": "editor::GoToDeclaration",
      "g r": "editor::FindAllReferences",
      "shift-k": "editor::Hover",

      // Structure / symbols
      "g shift-o": "outline::Toggle",
      "g o": "outline_panel::ToggleFocus",
      "g shift-w": "project_symbols::Toggle",

      // Tabs
      "space o": "pane::ActivateNextItem",
      "space i": "pane::ActivatePreviousItem",
      "space space": "tab_switcher::Toggle",

      "space .": "editor::Format",
      "space '": "workspace::ToggleZoom",
      "space j": "workspace::CloseAllDocks",
      // Modal picker of results (telescope-style); esc returns to the buffer
      "space f g": "project_search::OpenTextFinder",
      // Opens results as a tab instead
      "space f l": "pane::DeploySearch",

      // Panels / docks
      "ctrl-e": "project_panel::Toggle",
      "ctrl-shift-e": "workspace::ToggleLeftDock",

      // Toggles
      "space t c": "editor::ToggleEditPrediction",
      "space t h": "editor::ToggleInlayHints",

      // Git
      // "space g b": "git::Blame",
      // "space g o": "editor::OpenPermalinkToLine",
      "space g g": "git_panel::ToggleFocus",

      // Run / debug
      "space r r": "task::Spawn",
      "space r l": "task::Rerun",
      "space r b": "debugger::Start",
      // Open markdown preview
      "space m p": "markdown::OpenPreviewToTheSide",
      "space m P": "markdown::OpenPreview",
    },
  },

  // ── Inside the panels: same keys close the panel / jump back ─
  // ctrl-q closes the focused dock, mirroring ctrl-q closing a tab in the editor
  {
    "context": "Dock",
    "bindings": {
      "ctrl-q": "workspace::CloseActiveDock",
      "ctrl-shift-e": "workspace::ToggleLeftDock",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "ctrl-e": "project_panel::Toggle",
      "ctrl-n": "workspace::ToggleRightDock",

      // VSCode-style new file / folder (vim keymap defaults to netrw's % and d)
      "n": "project_panel::NewFile",
      "shift-n": "project_panel::NewDirectory",
      // "%": null,
      // "d": null,
    },
  },
  {
    "context": "OutlinePanel && not_editing",
    "bindings": {
      "g o": "outline_panel::ToggleFocus",
    },
  },
  {
    "context": "GitPanel && !CommitEditor",
    "bindings": {
      "space g g": "git_panel::ToggleFocus",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
    },
  },

  // ── Normal mode only ─────────────────────────────────────────
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "ctrl-/": ["workspace::SendKeystrokes", "g c c"],
    },
  },

  // ── Visual mode ──────────────────────────────────────────────
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "ctrl-/": "editor::ToggleComments",
      "shift-j": "editor::MoveLineDown",
      "shift-k": "editor::MoveLineUp",

      // Keep the selection after indenting
      "<": ["workspace::SendKeystrokes", "< g v"],
      ">": ["workspace::SendKeystrokes", "> g v"],

      // Don't overwrite the register when pasting over a selection
      "p": ["vim::Paste", { "preserve_clipboard": true }],
    },
  },

  // ── alt-j / alt-k as aliases for ctrl-n / ctrl-p ─────────────
  // Pickers, file finder, command palette
  {
    "context": "menu",
    "bindings": {
      "alt-j": "menu::SelectNext",
      "alt-k": "menu::SelectPrevious",
    },
  },
  // Word wrap: j/k walk display lines (nvim's gj/gk).
  // Zed has no expr mappings or count predicate, so the nvim version's
  // count branch (5j staying linewise + m` jumplist push) isn't possible —
  // a count here repeats the display-line motion instead.
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "j": ["vim::Down", { "display_lines": true }],
      "k": ["vim::Up", { "display_lines": true }],
      "alt-j": ["vim::Down", { "display_lines": true }],
      "alt-k": ["vim::Up", { "display_lines": true }],
    },
  },
  // Completion / code action popup in the editor
  {
    "context": "Editor && (showing_code_actions || showing_completions)",
    "bindings": {
      "alt-j": "editor::ContextMenuNext",
      "alt-k": "editor::ContextMenuPrevious",
    },
  },

  // ── Everywhere (extensions page, search, pickers, panels) ────
  // The leader (space) only exists under VimControl, i.e. inside a
  // buffer — these are the ctrl equivalents for the rest of the UI.
  {
    "context": "Workspace",
    "bindings": {
      // cmd-p equivalent — file finder on ctrl-p (nvim muscle memory)
      "ctrl-p": "file_finder::Toggle",
      "ctrl-e": "project_panel::Toggle",
      "ctrl-shift-e": "workspace::ToggleLeftDock",
      "ctrl-shift-o": "pane::ActivateNextItem",
      "ctrl-shift-i": "pane::ActivatePreviousItem",
      "ctrl-q": "pane::CloseActiveItem",
    },
  },
]
