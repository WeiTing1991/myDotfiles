// Zed tasks — ported from .vscode/tasks.json
//
// Run with `task: spawn` (see keymap: space r r), rerun with `task: rerun`.
// Docs: https://zed.dev/docs/tasks
//
// Differences from VS Code:
//  - no `dependsOn`; chain steps with `&&` in `command`
//  - no `problemMatcher`; Zed surfaces diagnostics via the language server
//  - no `group`; use `tags` for inline run buttons instead
//  - ${file} -> $ZED_FILE, ${fileDirname} -> $ZED_DIRNAME,
//    ${fileBasenameNoExtension} -> $ZED_STEM, ${workspaceFolder} -> $ZED_WORKTREE_ROOT
[
  // ── Python ───────────────────────────────────────────────────
  {
    "label": "Python: Run current file",
    "command": "python3",
    "args": ["$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "current",
    "reveal": "always"
  },
  {
    "label": "Python: Test",
    "command": "python3",
    "args": ["-m", "pytest", "-v"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all"
  },

  // ── C++ (CMake) ──────────────────────────────────────────────
  {
    "label": "C++: CMake Configure",
    "command": "cmake",
    "args": ["-S", ".", "-B", "build", "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "C++: Build",
    // VS Code's dependsOn: configure, then build
    "command": "cmake -S . -B build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON && cmake --build build",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all"
  },
  {
    "label": "C++: Run",
    "command": "cmake --build build && ./build/$(basename \"$ZED_WORKTREE_ROOT\")",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all"
  },
  {
    "label": "C++: Test (ctest)",
    "command": "cmake --build build && ctest --test-dir build --output-on-failure",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all"
  },
  {
    "label": "C/C++: clang build active file",
    "command": "clang",
    "args": ["-fcolor-diagnostics", "-fansi-escape-codes", "-g", "$ZED_FILE", "-o", "$ZED_DIRNAME/$ZED_STEM"],
    "cwd": "$ZED_DIRNAME",
    "save": "current"
  },

  // ── Rust ─────────────────────────────────────────────────────
  {
    "label": "Rust: Build",
    "command": "cargo",
    "args": ["build"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all"
  },
  {
    "label": "Rust: Run",
    "command": "cargo",
    "args": ["run"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all"
  },
  {
    "label": "Rust: Test",
    "command": "cargo",
    "args": ["test"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all"
  },

  // ── C# (dotnet) ──────────────────────────────────────────────
  {
    "label": "C#: Build",
    "command": "dotnet",
    "args": ["build"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all"
  },
  {
    "label": "C#: Run",
    "command": "dotnet",
    "args": ["run"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all"
  },
  {
    "label": "C#: Test",
    "command": "dotnet",
    "args": ["test"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all"
  },

  // ── TypeScript ───────────────────────────────────────────────
  {
    "label": "TS: Run current file",
    "command": "npx",
    "args": ["ts-node", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "current",
    "use_new_terminal": false
  },

  // ── Misc ─────────────────────────────────────────────────────
  {
    "label": "Run current file (by language)",
    "command": "case \"$ZED_LANGUAGE\" in Python) python3 \"$ZED_FILE\";; Rust) cargo run;; Lua) lua \"$ZED_FILE\";; \"Shell Script\") sh \"$ZED_FILE\";; *) echo \"no runner for $ZED_LANGUAGE\";; esac",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "current"
  }
]
