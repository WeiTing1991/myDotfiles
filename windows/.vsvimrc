" .vsvimrc — VsVim (Visual Studio)
" Kept in sync with .ideavimrc / .vscode/settings.json
" VsVim has no plugin system: no surround, commentary, highlightedyank, NERDTree.
" Command IDs: View > Other Windows > Command Window, or Tools > Options > Environment > Keyboard
" Keys VS steals (Ctrl+K chords, Ctrl+E, Ctrl+Q): see windows/README.md
" Mappings are non-recursive on purpose — nmap <C-d> <C-d>zz self-references and breaks.

" ── Core settings ────────────────────────────────────────────
set scrolloff=10
set incsearch
set hlsearch
set ignorecase
set smartcase
set number
set relativenumber
set visualbell
set clipboard=unnamed
set backspace=indent,eol,start
" needed for the g-prefixed mappings below to resolve reliably
set timeout
set timeoutlen=1000
" not supported by VsVim: sidescrolloff, showmode, foldlevel

" ── Leader ───────────────────────────────────────────────────
let mapleader = " "

" ── Editing ──────────────────────────────────────────────────
inoremap jk <Esc>

nnoremap Y y$

" Keep visual selection after indent
vnoremap < <gv
vnoremap > >gv

" Don't overwrite register on paste in visual
vnoremap p "_dP

" Move lines using the IDE
" visual :vsc gets a '<,'> prefix; if that ever errors, use :<C-u>vsc
vnoremap J :vsc Edit.MoveSelectedLinesDown<CR>
vnoremap K :vsc Edit.MoveSelectedLinesUp<CR>
nnoremap <A-j> :vsc Edit.MoveSelectedLinesDown<CR>
nnoremap <A-k> :vsc Edit.MoveSelectedLinesUp<CR>
vnoremap <A-j> :vsc Edit.MoveSelectedLinesDown<CR>
vnoremap <A-k> :vsc Edit.MoveSelectedLinesUp<CR>

" Comment (VS 17.11+ also binds Ctrl+/ natively)
nnoremap <C-/> :vsc Edit.ToggleLineComment<CR>
vnoremap <C-/> :vsc Edit.ToggleLineComment<CR>
nnoremap gcc :vsc Edit.ToggleLineComment<CR>
vnoremap gc :vsc Edit.ToggleLineComment<CR>

" ── Navigation ───────────────────────────────────────────────
nnoremap <C-d> <C-d>zz
nnoremap <C-u> <C-u>zz
nnoremap G Gzz
nnoremap n nzzzv
nnoremap N Nzzzv

nnoremap <Esc> :nohlsearch<CR>
nnoremap <C-c> :nohlsearch<CR>

" Jump list
" <C-i> remaps are ignored by VsVim (VsVim#2532); fall back to Ctrl+Shift+-
nnoremap <C-o> :vsc View.NavigateBackward<CR>
nnoremap <C-i> :vsc View.NavigateForward<CR>

" ── Windows ──────────────────────────────────────────────────
noremap <C-h> <C-w>h
noremap <C-l> <C-w>l
noremap <C-j> <C-w>j
noremap <C-k> <C-w>k

nnoremap <C-w>5 :vsc Window.NewHorizontalTabGroup<CR>
nnoremap <C-w>' :vsc Window.NewVerticalTabGroup<CR>

" Move current tab to the other tab group
nnoremap <C-w>m :vsc Window.MovetoNextTabGroup<CR>
nnoremap <C-w>M :vsc Window.MovetoPreviousTabGroup<CR>

nnoremap <leader>' :vsc View.FullScreen<CR>
" alternative: Window.AutoHide
nnoremap <leader>j :vsc Window.HideShowAllToolWindows<CR>

" Diagnostics (F8 / Shift+F8 in the error list)
nnoremap ]d :vsc Edit.GoToNextLocation<CR>
nnoremap [d :vsc Edit.GoToPrevLocation<CR>

" ── Tabs & buffers ───────────────────────────────────────────
nnoremap <leader>o :vsc Window.NextTab<CR>
nnoremap <leader>i :vsc Window.PreviousTab<CR>

nnoremap <C-q> :vsc Window.CloseDocumentWindow<CR>
nnoremap <C-e> :vsc View.SolutionExplorer<CR>
nnoremap <leader>e :vsc SolutionExplorer.SyncWithActiveDocument<CR>

" ── LSP / Go-to ──────────────────────────────────────────────
nnoremap gd :vsc Edit.GoToDefinition<CR>
nnoremap gh :vsc Edit.GoToDefinition<CR>
nnoremap gD :vsc Edit.PeekDefinition<CR>
nnoremap gy :vsc Edit.GoToTypeDefinition<CR>
nnoremap gr :vsc Edit.FindAllReferences<CR>

nnoremap K :vsc Edit.QuickInfo<CR>
" code actions / light bulb — VS calls it Show Smart Tag (native: Ctrl+.)
nnoremap g. :vsc View.ShowSmartTag<CR>

nnoremap gO :vsc Edit.GoToMember<CR>
nnoremap go :vsc View.DocumentOutline<CR>
nnoremap gW :vsc Edit.GoToAll<CR>

" C/C++ header <-> source
nnoremap gI :vsc EditorContextMenus.CodeWindow.ToggleHeaderCodeFile<CR>

" ── Search & find ────────────────────────────────────────────
nnoremap <leader>ff :vsc Edit.GoToFile<CR>
nnoremap <leader>fl :vsc Edit.FindinFiles<CR>
nnoremap <leader>fb :vsc Window.NextDocumentWindowNav<CR>
nnoremap <leader><leader> :vsc Window.NextDocumentWindowNav<CR>

nnoremap <leader>S :vsc Edit.Replace<CR>
nnoremap <leader>s :vsc Edit.ReplaceinFiles<CR>

nnoremap <C-p> :vsc Edit.GoToAll<CR>

" ── Refactor & format ────────────────────────────────────────
nnoremap <leader>. :vsc Edit.FormatDocument<CR>
vnoremap <leader>. :vsc Edit.FormatSelection<CR>
nnoremap <F2> :vsc Refactor.Rename<CR>

" ── Run & debug ──────────────────────────────────────────────
nnoremap <F5> :vsc Debug.Start<CR>
nnoremap <F9> :vsc Debug.ToggleBreakpoint<CR>
nnoremap <C-`> :vsc View.Terminal<CR>
nnoremap <C-S-m> :vsc View.ErrorList<CR>

" ── VCS ──────────────────────────────────────────────────────
nnoremap <leader>gg :vsc Team.Git.GoToGitChanges<CR>

" ── Save ─────────────────────────────────────────────────────
nnoremap <C-s> :vsc File.SaveSelectedItems<CR>

" ── Unverified command IDs ───────────────────────────────────
" Confirm each in Tools > Options > Environment > Keyboard, then uncomment.
" nnoremap gi :vsc Edit.GoToImplementation<CR>   " search: GoToImplementation (fallback: Edit.GoToDeclaration, Ctrl+F12)
" nnoremap gs :vsc Edit.GoToBase<CR>             " search: GoToBase
" nnoremap ]c :vsc ?<CR>                         " search: NextChange     (git hunk)
" nnoremap [c :vsc ?<CR>                         " search: PreviousChange (git hunk)
" nnoremap <leader>tc :vsc ?<CR>                 " search: Copilot completions toggle
" nnoremap <leader>th :vsc ?<CR>                 " search: InlineHints
